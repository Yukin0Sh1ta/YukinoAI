{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "YukinoAI",
  "version": "0.1.0",
  "identifier": "com.yukinoai.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "YukinoAI",
        "width": 250,
        "height": 400,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true
      },
      {
        "label": "settings",
        "title": "Settings",
        "url": "/settings",
        "width": 700,
        "height": 500,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": false,
        "alwaysOnTop": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
